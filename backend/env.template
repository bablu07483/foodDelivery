# MongoDB Atlas Connection String
# Get your connection string from MongoDB Atlas dashboard:
# 1. Go to your cluster
# 2. Click "Connect"
# 3. Choose "Connect your application"
# 4. Copy the connection string
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fooddelivery?retryWrites=true&w=majority

# Server Port (optional, defaults to 3000)
PORT=3000

# JWT Secret Key (for authentication)
JWT_SECRET=your-secret-key-here-change-this-in-production


